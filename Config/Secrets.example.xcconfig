// Copy this file to Secrets.xcconfig in the same folder and fill in your values.
// Secrets.xcconfig is gitignored, so your token never reaches GitHub.

// Your Notion integration's secret (notion.so/profile/integrations → your integration →
// Configuration → Internal Integration Secret). Read-only access is enough.
NOTION_TOKEN = ntn_your_token

// The Court & Capital page: the 32-character ID at the end of its link, with or without
// dashes. Don't paste the whole link: xcconfig files treat // as the start of a comment.
NOTION_PAGE_ID = your_page_id

// Your Apple team ID (Xcode → Settings → Accounts → your team), so signing survives
// regenerating the project with xcodegen.
DEVELOPMENT_TEAM =
