// Copy this file to Secrets.xcconfig in the same folder and fill in your values.
// Secrets.xcconfig is gitignored, so your keys never reach GitHub.

// Supabase → Project Settings → API Keys (or the Connect button).
// The host only, without https:// — xcconfig files treat // as the start of a comment.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_your_key

// Your Apple team ID (Xcode → Settings → Accounts → your team), so signing survives
// regenerating the project with xcodegen.
DEVELOPMENT_TEAM =
